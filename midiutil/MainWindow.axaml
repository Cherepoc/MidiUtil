<Window x:Class="MidiUtil.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:vm="using:MidiUtil.Models"
        d:DataContext="{d:DesignInstance vm:MainModel}"
        x:DataType="vm:MainModel"
        Title="RMG MIDI Util" Height="680" Width="900" MinHeight="300" MinWidth="560">
    <Window.Styles>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="#E5484D" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16, 12" />
            <Setter Property="Margin" Value="0, 0, 0, 12" />
            <Setter Property="BoxShadow" Value="0 1 4 0 #18000000" />
        </Style>
        <Style Selector="Border.card.off">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8, 1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14, 6" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open" Click="MenuItemOpen_OnClick" />
                <MenuItem Header="_Save" Click="MenuItemSave_OnClick"
                          IsEnabled="{Binding MidiFile.CanSave, FallbackValue=False}" />
                <MenuItem Header="Save _As" Click="MenuItemSaveAs_OnClick"
                          IsEnabled="{Binding MidiFile.CanSave, FallbackValue=False}" />
                <Separator />
                <MenuItem Header="_Exit" Click="MenuItemExit_OnClick" />
            </MenuItem>
        </Menu>

        <Grid>
            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                        IsVisible="{Binding MidiFile, Converter={x:Static ObjectConverters.IsNull}}">
                <TextBlock Text="🎹" FontSize="56" HorizontalAlignment="Center" />
                <TextBlock Classes="title" Text="No MIDI file open" HorizontalAlignment="Center" />
                <TextBlock Classes="muted" Text="Open a file to view tracks, remove them or shuffle instruments."
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Classes="accent" Content="Open MIDI file…" HorizontalAlignment="Center"
                        Click="MenuItemOpen_OnClick" />
            </StackPanel>

            <!-- Loaded file -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          DataContext="{Binding MidiFile}"
                          IsVisible="{Binding Path=., Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel x:DataType="vm:MidiFileModel" Margin="24" MaxWidth="900"
                            Grid.IsSharedSizeScope="True">

                    <!-- File header + randomize controls -->
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="title" Text="{Binding Filename}" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" Text="{Binding Path}" FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Separator />
                            <WrapPanel>
                                <Button Classes="accent" Content="Randomize all programs"
                                        Command="{Binding RandomizeAllProgramsCommand}"
                                        Margin="0, 0, 16, 0" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0, 0, 12, 0">
                                    <TextBlock Classes="muted" Text="From" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding MinAvailableRandomPrograms}"
                                              SelectedValue="{Binding MinRandomProgram}"
                                              SelectedValueBinding="{Binding Program}" Width="220">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProgramModel">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="muted" Text="to" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding MaxAvailableRandomPrograms}"
                                              SelectedValue="{Binding MaxRandomProgram}"
                                              SelectedValueBinding="{Binding Program}" Width="220">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProgramModel">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Background="#22E5484D" BorderBrush="#E5484D"
                            IsVisible="{Binding !CanSave}">
                        <TextBlock Classes="error" Text="At least one track must be enabled." />
                    </Border>

                    <!-- Tracks -->
                    <ItemsControl ItemsSource="{Binding Tracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MidiTrackModel">
                                <Border Classes="card" Classes.off="{Binding !IsEnabled}">
                                    <StackPanel Spacing="8">
                                        <CheckBox Content="{Binding Name}" FontWeight="SemiBold"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                        <ItemsControl ItemsSource="{Binding ProgramChangeEvents}"
                                                      Margin="28, 0, 0, 0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProgramChangeEventModel">
                                                    <Grid Margin="0, 3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ProgramChangeEventName" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                    Spacing="8" VerticalAlignment="Center"
                                                                    Margin="0, 0, 16, 0">
                                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                                                                       VerticalAlignment="Center" />
                                                            <Border Classes="badge" IsVisible="{Binding IsPercussion}">
                                                                <TextBlock Text="DRUMS" />
                                                            </Border>
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" Width="240"
                                                                  ItemsSource="{x:Static vm:ProgramModel.Items}"
                                                                  SelectedValue="{Binding Program}"
                                                                  SelectedValueBinding="{Binding Program}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ProgramModel">
                                                                    <TextBlock Text="{Binding Name}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <Button Grid.Column="2" Content="Randomize" Margin="8, 0, 0, 0"
                                                                IsVisible="{Binding !IsPercussion}"
                                                                CommandParameter="{Binding}"
                                                                Command="{Binding $parent[Window].DataContext.MidiFile.RandomizeProgramCommand, FallbackValue={x:Null}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
